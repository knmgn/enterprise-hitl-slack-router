# Slack Configuration
# Incoming Webhook for sending alert / action cards
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/<WORKSPACE_ID>/<BOT_ID>/<TOKEN>"
# Optional: Slack app signing secret from Basic Information for HMAC verification
SLACK_SIGNING_SECRET="your_slack_signing_secret_here"

# HubSpot CRM Configuration
# Service Key (Private app token substitute)
HUBSPOT_SERVICE_KEY="pat-na2-your-service-key-here"
HUBSPOT_PORTAL_ID="your_hubspot_portal_id"
HUBSPOT_API_BASE="https://api.hubapi.com"
HUBSPOT_APP_BASE="https://app-na2.hubspot.com"

# Ticket Pipeline Stages (Specific to your portal)
HUBSPOT_STAGE_NEW="4429719242"
HUBSPOT_STAGE_ESCALATED="4429719244"
HUBSPOT_STAGE_WAITING_CUSTOMER="4429719243"
HUBSPOT_STAGE_CLOSED="4429719245"

# AI Triage & Guardrails
# Leave blank to use deterministic rule-based fallback
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Policy Thresholds (Code-enforced guardrails)
REFUND_APPROVAL_THRESHOLD=100.0
CONFIDENCE_THRESHOLD=0.8
POLL_INTERVAL_SECONDS=5.0
